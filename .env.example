# Keep this file local. Do not commit your resume, profile, or application data.
# Auto-submission requires ALL three: config.autoSubmitEnabled=true,
# a URL host on approvedSubmissionHosts, and an uncomplicated completed form.
# LinkedIn is intentionally unsupported for browser automation.
HEADLESS=true
SLOW_MO_MS=0
